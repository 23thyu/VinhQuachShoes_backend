PORT=3009
NODE_ENV=development

# Database configuration (Aiven MySQL or Local)
DB_DEV_USERNAME=avnadmin
DB_DEV_PASSWORD=your_aiven_password_here
DB_DEV_DATABASE=defaultdb
DB_DEV_PORT=12979
DB_DEV_HOST=your_aiven_host_here.aivencloud.com
DB_DEV_DIALECT=mysql
DB_DEV_SSL_CA=your_ssl_ca_cert_content_here (paste the content of ca.pem here on Render)

# JWT Settings
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=30d

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
